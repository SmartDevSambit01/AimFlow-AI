# AimFlow AI Server Configuration
# ==============================================================================
# Port for the local Node.js backend server
PORT=3000

# AI Provider Configuration
# Options: openai | gemini
# - openai  → Uses OpenAI Chat Completions API (requires paid credits)
# - gemini  → Uses Google Gemini API (FREE tier available, no credit card needed)
AI_PROVIDER=gemini

# ──────────────────────────────────────────────────────────────────────────────
# Google Gemini AI (FREE tier — recommended)
# 1. Go to: https://aistudio.google.com/app/apikey
# 2. Sign in with your Google account
# 3. Click "Create API Key" → copy the key
# 4. Paste it below
# KEEP THIS SECRET! Never commit this file or expose it in client code.
# ──────────────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
# Gemini Model (used when AI_PROVIDER=gemini)
# gemini-3.8-flash — supported model for chat and tool calling
GEMINI_MODEL=gemini-3.8-flash

# ──────────────────────────────────────────────────────────────────────────────
# OpenAI (optional fallback — requires paid credits)
# Obtain your API key at: https://platform.openai.com/api-keys
# ──────────────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI Model Selection (used when AI_PROVIDER=openai)
OPENAI_MODEL=gpt-4o-mini

# Optional: Custom API Base URL (for Azure, Bedrock proxy, or local LLM servers)
# OPENAI_BASE_URL=https://api.openai.com/v1
